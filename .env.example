# Project URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project credentials (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server URL for tooling scripts (same value as NEXT_PUBLIC_SUPABASE_URL, but
# server-only). Consumed by scripts/weekly-report.mjs and set as a GitHub
# Actions secret. Never used in the browser.
# SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key - ONLY for server-side scripts (weekly report, DB ops),
# NEVER for the client. Also set as a GitHub Actions secret.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Serverless DB connection string (raw Postgres only: migration scripts, CLIs)
# Mandatory rule: PgBouncer in transaction mode on port 6543 with ?pgbouncer=true
# and disabled prepared statements cache to avoid connection exhaustion.
# DATABASE_URL=postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&options=prepared_statement_cache_mode=transaction

# Database password for local tooling (Supabase CLI: link/db push/psql).
# DANGER: never commit this value - store it in a password manager instead.
# The Supabase CLI reads it from this env var to avoid interactive prompts.
# SUPABASE_DB_PASSWORD=your-database-password

# Custom SMTP provider for auth emails. Free-tier projects can only customize
# email templates with a custom provider (Auth > SMTP). Copy this block into a
# git-ignored smtp.env.local and run:
#   node scripts/apply-email-templates.mjs --with-smtp
# Add the same values in Supabase Dashboard > Authentication > SMTP Settings.
SMTP_HOST=your-smtp-host.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME=Hub
SMTP_SENDER_EMAIL=no-reply@your-verified-domain.com
# SMTP_ADMIN_EMAIL=support@your-verified-domain.com